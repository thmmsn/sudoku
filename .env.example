# Copy to .env and change what you need. Everything is optional.

# Port on the host, and which address to listen on (127.0.0.1 behind a proxy
# on the same machine).
SUDOKU_PORT=3000
SUDOKU_BIND=0.0.0.0

# Where profiles are kept: a named volume, or a folder such as ./data
SUDOKU_DATA=sudoku-data

# Folder with puzzle files (csv, txt, json, jsonl)
SUDOKU_PUZZLES=./puzzles

# Total size of all profiles in bytes (1 GB)
DATA_MAX_BYTES=1073741824

# New profiles and imports per IP address per hour
RATE_NEW_PROFILES=20
RATE_IMPORTS=30

# 1 when running behind a reverse proxy
TRUST_PROXY=0
